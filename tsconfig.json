{
  // "extends": "@react-native/typescript-config" is canonical but Cursor didnt like it.
  "extends": "./node_modules/@react-native/typescript-config/tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ],
  "compilerOptions": {
    "jsx": "react-native",
    "types": ["jest"],
    // https://github.com/vonovak/react-navigation-header-buttons/blob/master/INSTALL.md
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#src/*": [
        "./src/*"
      ],
      "#assets/*": [
        "./assets/*"
      ],
      "#specs/*": [
        "./specs/*"
      ],
      "#scripts/*": [
        "./scripts/*"
      ],
      // RN 0.88 gives Libraries/* no types (exports map `types: null`), so the codegen
      // EventEmitter import in specs/ resolves to `any`. Point it at the generated declaration.
      "react-native/Libraries/Types/CodegenTypes": [
        "./node_modules/react-native/types_generated/Libraries/Types/CodegenTypes.d.ts"
      ]
    }
  }
}